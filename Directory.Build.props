<Project>
  <PropertyGroup>
    <TargetFramework Condition="'$(TargetFramework)' == '' and '$(TargetFrameworks)' == ''">net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetLockFilePath Condition="'$(NuGetLockFilePath)' == ''">$(MSBuildProjectDirectory)/packages.lock.json</NuGetLockFilePath>
    <RestoreLockedMode Condition="'$(ContinuousIntegrationBuild)' == 'true'">true</RestoreLockedMode>
  </PropertyGroup>

  <Target Name="RequireReviewedPackageLock" BeforeTargets="Restore"
          Condition="'$(RestoreLockedMode)' == 'true'">
    <Error Condition="!Exists('$(NuGetLockFilePath)')"
           Text="Commit a reviewed packages.lock.json before running locked restore." />
  </Target>

  <Target Name="RequireNet10" BeforeTargets="PrepareForBuild"
          Condition="'$(IsCrossTargetingBuild)' != 'true'">
    <Error Condition="'$(TargetFrameworkIdentifier)' != '.NETCoreApp' or '$(TargetFrameworkVersion)' != 'v10.0'"
           Text="Managed projects must target .NET 10 (net10.0 or net10.0-windows)." />
  </Target>
</Project>
