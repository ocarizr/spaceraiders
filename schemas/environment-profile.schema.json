{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spaceraiders.invalid/schemas/v1/environment-profile.schema.json",
  "title": "Raiders setup profile catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_id", "revision", "setup_host", "profiles"],
  "properties": {
    "schema_version": { "const": 1 },
    "catalog_id": { "$ref": "#/$defs/id" },
    "revision": { "type": "integer", "minimum": 1 },
    "setup_host": {
      "type": "object", "additionalProperties": false,
      "required": ["language", "framework", "runtime_identifier", "deployment", "requires_installed_sdk", "requires_python", "requires_game"],
      "properties": {
        "language": { "const": "csharp" },
        "framework": { "const": "net10.0-windows" },
        "runtime_identifier": { "const": "win-x64" },
        "deployment": { "const": "self-contained" },
        "requires_installed_sdk": { "const": false },
        "requires_python": { "const": false },
        "requires_game": { "const": false }
      }
    },
    "profiles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/profile" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$" },
    "version": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}(?:[-+][A-Za-z0-9.-]+)?$", "maxLength": 128 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["operating_system", "architecture"],
      "properties": { "operating_system": { "const": "windows" }, "architecture": { "const": "x64" } }
    },
    "constraint": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "value"],
          "properties": { "kind": { "const": "exact" }, "value": { "$ref": "#/$defs/version" } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "values"],
          "properties": { "kind": { "const": "one-of" }, "values": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/version" } } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "value", "roll_forward", "allow_prerelease"],
          "properties": {
            "kind": { "const": "sdk-feature-band" }, "value": { "type": "string", "pattern": "^10\\.[0-9]+\\.[0-9]{3}$" },
            "roll_forward": { "const": "latestPatch" }, "allow_prerelease": { "const": false }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "reference"],
          "properties": { "kind": { "enum": ["manifest", "configuration"] }, "reference": { "$ref": "#/$defs/id" } }
        }
      ]
    },
    "requirement": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "required", "probe_id", "architecture", "constraint", "depends_on", "recipe_ref"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["native-toolchain", "native-sdk", "build-tool", "managed-sdk", "package-feed", "python-interpreter", "python-environment", "lua-toolchain", "code-editor", "artifact-bundle"] },
        "required": { "type": "boolean" },
        "probe_id": { "$ref": "#/$defs/id" },
        "architecture": { "enum": ["x64", "any"] },
        "constraint": { "$ref": "#/$defs/constraint" },
        "depends_on": { "$ref": "#/$defs/ids" },
        "recipe_ref": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] }
      }
    },
    "profile": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "roles", "target", "depends_on", "requirements"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1, "maxLength": 128 },
        "roles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["native-developer", "tooling-developer", "pipeline-developer", "lua-developer", "designer"] } },
        "target": { "$ref": "#/$defs/target" },
        "depends_on": { "$ref": "#/$defs/ids" },
        "requirements": { "type": "array", "minItems": 1, "contains": { "properties": { "required": { "const": true } } }, "items": { "$ref": "#/$defs/requirement" } }
      }
    }
  }
}
