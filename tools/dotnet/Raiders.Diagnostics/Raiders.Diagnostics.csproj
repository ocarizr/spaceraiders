<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Version>0.1.0</Version>
        <Description>Structured logging and optional elapsed-time profiling for Raiders Engine tools.</Description>
        <RaidersEnableProfiling Condition="'$(RaidersEnableProfiling)' == ''">false</RaidersEnableProfiling>
        <DefineConstants Condition="'$(RaidersEnableProfiling)' == 'true'">$(DefineConstants);RA_ENABLE_PROFILING</DefineConstants>
    </PropertyGroup>
    <ItemGroup>
        <Compile Remove="tests/**/*.cs" />
    </ItemGroup>
</Project>
