<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <RaidersEnableProfiling Condition="'$(RaidersEnableProfiling)' == ''">false</RaidersEnableProfiling>
        <DefineConstants Condition="'$(RaidersEnableProfiling)' == 'true'">$(DefineConstants);RA_ENABLE_PROFILING</DefineConstants>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../Raiders.Diagnostics.csproj" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="MSTest.TestAdapter" />
        <PackageReference Include="MSTest.TestFramework" />
    </ItemGroup>
</Project>
