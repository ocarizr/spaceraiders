<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Version>0.1.0</Version>
        <Description>Read-only Windows environment probes and profile health for Raiders tools.</Description>
        <RaidersEnableProfiling Condition="'$(RaidersEnableProfiling)' == ''">false</RaidersEnableProfiling>
        <DefineConstants Condition="'$(RaidersEnableProfiling)' == 'true'">$(DefineConstants);RA_ENABLE_PROFILING</DefineConstants>
    </PropertyGroup>
    <ItemGroup>
        <Compile Remove="tests/**/*.cs" />
        <ProjectReference Include="../Raiders.Diagnostics/Raiders.Diagnostics.csproj" />
    </ItemGroup>
</Project>
